  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "  My dear, lovely wife. \n\nI know I have only been gone a few days, but
    I have missed you every moment. When I saw these beautiful flowers, I could only
    think of you. Their rarity on this floor of the dungeon only made me long for
    you more. You are like a rare flower. An impossible find, incomparable to any
    others. I hope I can give you an, I\u2019m sure much needed, respite from the
    children\u2019s antics now that I\u2019m home. \r\n\n\t\tFrom your one and bonely,
    \n\t\t\t\t\tJerald\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 93e188d05292df14a94a9733dbf12ad0, type: 2}
